rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/partecipanti/$(request.auth.uid)).data.isAdmin == true;
    }

    function isApprovato() {
      let d = get(/databases/$(database)/documents/partecipanti/$(request.auth.uid)).data;
      return isAuth() && d.approvato == true && d.get('disabilitato', false) != true;
    }

    // ── PARTECIPANTI ──────────────────────────────────
    match /partecipanti/{uid} {
      // Lettura: ognuno può leggere il proprio profilo (serve per controllare approvato);
      //          gli admin leggono tutti.
      allow read: if isAuth() && (request.auth.uid == uid || isAdmin());

      // Creazione: un utente autenticato può creare SOLO il proprio documento,
      //            con approvato: false obbligatorio (non può auto-approvarsi).
      allow create: if isAuth()
        && request.auth.uid == uid
        && request.resource.data.approvato == false
        && request.resource.data.isAdmin == false;

      // Aggiornamento: solo admin possono modificare (approvazione, correzioni).
      // Un utente con isOwner:true può essere modificato SOLO da se stesso,
      // così nessun altro admin può revocargli i privilegi.
      allow update: if isAdmin() && (
        !resource.data.get('isOwner', false) ||
        request.auth.uid == uid
      );

      // Cancellazione: solo admin (rifiuto richieste).
      allow delete: if isAdmin();
    }

    // ── COMPETIZIONI ───────────────────────────────────
    // Più competizioni (es. "monza", "madrid") nella stessa app, stesso login:
    // chi è approvato in partecipanti/{uid} lo è per TUTTE le competizioni
    // (nessuna approvazione separata per competizione). I dati di ciascuna
    // gara (pronostici, risultati, classifica, sistema) sono isolati sotto
    // competizioni/{compId}/... — le classifiche NON si sommano tra gare.
    //
    // Allineata al frontend (cfg?.pronostici_aperti !== false): se il
    // documento di config o il campo mancano, i pronostici sono APERTI di default.
    function pronosticiAperti(compId) {
      let cfgPath = /databases/$(database)/documents/competizioni/$(compId)/sistema/config;
      return (!exists(cfgPath)) || (get(cfgPath).data.get('pronostici_aperti', true) == true);
    }

    match /competizioni/{compId} {

      // ── PRONOSTICI ──────────────────────────────────
      // Tutti gli approvati possono leggere (per vedere le schede altrui dalla
      // classifica). Il proprietario può scrivere la propria scheda SOLO mentre
      // i pronostici di QUESTA competizione sono aperti. LOCK UNICO per
      // Qualifiche e Gara (non due sessioni indipendenti): il pronostico di
      // gara non si può modificare dopo le qualifiche, quindi entrambe si
      // chiudono nello stesso istante, all'inizio delle qualifiche. Gli admin
      // possono sempre scrivere (correzioni manuali durante il weekend).
      match /pronostici/{uid} {
        allow read:  if isApprovato();
        allow write: if (isApprovato() && request.auth.uid == uid && pronosticiAperti(compId)) || isAdmin();
      }

      // ── RISULTATI ───────────────────────────────────
      match /risultati/{doc} {
        allow read: if isApprovato();
        allow write: if isAdmin(); // Admin inserisce i risultati a mano
      }

      // ── CLASSIFICA ──────────────────────────────────
      match /classifica/{doc} {
        allow read: if isApprovato();
        allow write: if isAdmin(); // Cloud Function + ricalcolo manuale admin
      }

      // ── LIVE ────────────────────────────────────────
      match /live/{doc} {
        allow read: if isApprovato();
        // Admin può scrivere; la Cloud Function usa l'Admin SDK e bypassa
        // comunque le regole.
        allow write: if isAdmin();
      }

      // ── SISTEMA / CONFIG ────────────────────────────
      match /sistema/{doc} {
        allow read:  if isAuth(); // anche non approvati (serve per sapere se pronostici aperti)
        allow write: if isAdmin();
      }
    }

    // ── LEGACY (percorsi piatti pre-multi-competizione) ─
    // Usati SOLO dallo script di migrazione una tantum che copia i dati del
    // GP d'Italia (Monza) dai vecchi percorsi piatti a competizioni/monza/...
    // Accesso ristretto agli admin: nessun client li legge più a regime.
    // Da rimuovere da queste regole una volta completata e verificata la migrazione.
    match /pronostici/{uid}  { allow read, write: if isAdmin(); }
    match /risultati/{doc}   { allow read, write: if isAdmin(); }
    match /classifica/{doc}  { allow read, write: if isAdmin(); }
    match /live/{doc}        { allow read, write: if isAdmin(); }
    match /sistema/{doc}     { allow read, write: if isAdmin(); }
  }
}
